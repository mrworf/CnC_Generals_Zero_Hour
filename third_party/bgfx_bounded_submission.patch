+		static bool accepts(const BoundedSubmissionDesc& _desc, uint32_t _commands)
+		{
+			return 0 != _desc.generation && 0 != _commands
+				&& _commands <= _desc.commands && _desc.commands <= commands
+				&& _desc.draws <= draws && _desc.views <= views
+				&& _desc.resources <= resources
+				&& 0 != _desc.bytes && _desc.bytes <= bytes;
+		}
+	};
