+	/// Opt-in bounded synchronous native submission. Ordinary API use is unchanged.
+	/// A complete immutable manifest is validated/copied/reserved before replay.
+	/// No external token interval, resource creation, callback or recoverable
+	/// capacity failure is permitted after replay begins. Vulkan worker/device
+	/// failure retains the ordinary native fatal boundary.
+	struct BoundedSubmissionDesc
+	{
+		uint64_t generation = 0;
+		uint32_t commands = 0;
+		uint32_t draws = 0;
+		uint32_t views = 0;
+		uint32_t resources = 0;
+		uint32_t bytes = 0;
+	};
