+		// UINT8_MAX preserves the ordinary full-remaining-range default. Explicit
+		// ranges are checked with subtraction before reservation or native replay.
+		static bool acceptsMipRange(uint32_t _first, uint32_t _count, uint32_t _levels)
+		{
+			return 0 != _levels && _levels <= UINT8_MAX && _first < _levels
+				&& 0 != _count && _count <= UINT8_MAX
+				&& (UINT8_MAX == _count || _count <= _levels - _first);
+		}
