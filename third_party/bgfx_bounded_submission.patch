+	struct BoundedSubmissionCommand
+	{
+		enum Kind : uint8_t { View, Draw, ResizeSwapChain, Retire, CompleteFrame, Count };
+		enum Resource : uint8_t { Vertex, Index, Texture, Shader, Program, FrameBuffer, ResourceCount };
+
+		Kind kind = Count;
+		Resource resource = ResourceCount;
+		uint16_t resourceIndex = UINT16_MAX;
+		ViewId view = UINT16_MAX;
+		FrameBufferHandle framebuffer = BGFX_INVALID_HANDLE;
+		int16_t x = 0, y = 0;
+		uint16_t width = 0, height = 0;
+		float minDepth = 0.0f, maxDepth = 1.0f;
+		uint16_t clearFlags = BGFX_CLEAR_NONE;
+		uint32_t clearRgba = 0;
+		float clearDepth = 1.0f;
+		uint8_t clearStencil = 0;
+		bool touch = false;
