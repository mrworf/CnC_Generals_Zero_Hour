+		ProgramHandle program = BGFX_INVALID_HANDLE;
+		VertexBufferHandle vertex = BGFX_INVALID_HANDLE;
+		IndexBufferHandle index = BGFX_INVALID_HANDLE;
+		uint32_t firstVertex = 0, vertices = 0, firstIndex = 0, indices = 0;
+		uint64_t state = BGFX_STATE_NONE;
+		uint32_t rgba = 0, stencilFront = BGFX_STENCIL_NONE, stencilBack = BGFX_STENCIL_NONE;
+		int32_t depthBias = 0;
+		const BoundedSubmissionUniform* uniforms = NULL;
+		const BoundedSubmissionTexture* textures = NULL;
+		uint16_t uniformCount = 0, textureCount = 0;
+		SwapChain swapChain;
+	};
+
+	struct BoundedSubmissionReceipt
+	{
+		uint64_t context = 0, sequence = 0, generation = 0;
+		uint32_t frameBefore = 0, frameAfter = 0, draws = 0, views = 0;
+		uint32_t bindingsBefore = 0, bindingsAfter = 0;
+	};
+
+	/// Performs one complete synchronous admission/reservation/replay.
+	/// False means no manifest view/submit/resize/retirement/frame was emitted;
+	/// _receipt stays unchanged. Only API-thread multithreaded native contexts
+	/// with no overlapping encoder, dynamic retirement or cached-view uniforms
+	/// are supported. All manifest pointers must address the declared readable
+	/// input until this call returns. Successful replay consumes the manifest
+	/// once; high-level retry/generation ownership belongs to the caller.
+	bool submitBounded(
+		  const BoundedSubmissionDesc& _desc
+		, const BoundedSubmissionCommand* _commands
+		, uint32_t _count
+		, BoundedSubmissionReceipt& _receipt
+		);
+
+	/// Read-only generated allocator diagnostics. Render workers report Idle.
+	enum class BoundedSubmissionPhase : uint8_t { Idle, Preparing, Replaying };
+	BoundedSubmissionPhase boundedSubmissionPhase();
+
