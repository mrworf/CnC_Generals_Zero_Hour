+	// All extension state is API-thread-local. Render workers never enter replay.
+	static BX_THREAD_LOCAL BoundedSubmissionPhase s_boundedPhase = BoundedSubmissionPhase::Idle;
+	static BX_THREAD_LOCAL bool s_boundedCompletion = false;
+	static BX_THREAD_LOCAL uint8_t* s_boundedUniforms = NULL;
