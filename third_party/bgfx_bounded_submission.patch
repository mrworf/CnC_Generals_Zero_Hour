+	struct BoundedSubmissionLimits
+	{
+		static constexpr uint32_t commands = 4096;
+		static constexpr uint32_t draws = 4096;
+		static constexpr uint32_t views = 256;
+		static constexpr uint32_t resources = 4096;
+		static constexpr uint32_t bytes = 64u << 20;
+
+		// Pinned native encoded-field extents, including ignored-but-indexed
+		// values. Reject unknown gap bits, not just the native reserved mask.
+		static bool acceptsState(uint64_t _state, uint32_t _rgba)
+		{
+			const uint64_t known = BGFX_STATE_WRITE_MASK | BGFX_STATE_DEPTH_TEST_MASK
+				| BGFX_STATE_BLEND_MASK | BGFX_STATE_BLEND_EQUATION_MASK
+				| BGFX_STATE_CULL_MASK | BGFX_STATE_ALPHA_REF_MASK | BGFX_STATE_PT_MASK
+				| BGFX_STATE_POINT_SIZE_MASK | BGFX_STATE_MSAA | BGFX_STATE_LINEAA
+				| BGFX_STATE_CONSERVATIVE_RASTER | BGFX_STATE_FRONT_CCW
+				| BGFX_STATE_BLEND_INDEPENDENT | BGFX_STATE_BLEND_ALPHA_TO_COVERAGE;
+			if ((_state & ~known) != 0
+			|| ((_state & BGFX_STATE_DEPTH_TEST_MASK) >> BGFX_STATE_DEPTH_TEST_SHIFT) > 8
+			|| ((_state & BGFX_STATE_CULL_MASK) >> BGFX_STATE_CULL_SHIFT) > 2
+			|| ((_state & BGFX_STATE_PT_MASK) >> BGFX_STATE_PT_SHIFT) > 4)
+				return false;
+			const uint32_t blend = uint32_t((_state & BGFX_STATE_BLEND_MASK) >> BGFX_STATE_BLEND_SHIFT);
+			for (uint32_t shift = 0; shift < 16; shift += 4)
+				if (((blend >> shift) & 15) > 13)
+					return false;
+			const uint32_t equations = uint32_t((_state & BGFX_STATE_BLEND_EQUATION_MASK) >> BGFX_STATE_BLEND_EQUATION_SHIFT);
+			if ((equations & 7) > 4 || ((equations >> 3) & 7) > 4)
+				return false;
+			if (0 != (_state & BGFX_STATE_BLEND_INDEPENDENT))
+				for (uint32_t target = 0; target < 3; ++target, _rgba >>= 11)
+					if ((_rgba & 15) > 13 || ((_rgba >> 4) & 15) > 13 || ((_rgba >> 8) & 7) > 4)
+						return false;
+			return true;
+		}
+		static bool acceptsStencil(uint32_t _stencil)
+		{
+			return ((_stencil & BGFX_STENCIL_TEST_MASK) >> BGFX_STENCIL_TEST_SHIFT) <= 8
+				&& ((_stencil & BGFX_STENCIL_OP_FAIL_S_MASK) >> BGFX_STENCIL_OP_FAIL_S_SHIFT) <= 7
+				&& ((_stencil & BGFX_STENCIL_OP_FAIL_Z_MASK) >> BGFX_STENCIL_OP_FAIL_Z_SHIFT) <= 7
+				&& ((_stencil & BGFX_STENCIL_OP_PASS_Z_MASK) >> BGFX_STENCIL_OP_PASS_Z_SHIFT) <= 7;
+		}
+		static bool acceptsSamplerFlags(uint32_t _flags)
+		{
+			const uint32_t known = BGFX_SAMPLER_BITS_MASK | BGFX_SAMPLER_BORDER_COLOR_MASK
+				| BGFX_SAMPLER_SAMPLE_STENCIL | BGFX_SAMPLER_SRGB;
+			return 0 == (_flags & ~known)
+				&& ((_flags & BGFX_SAMPLER_MIN_MASK) >> BGFX_SAMPLER_MIN_SHIFT) <= 2
+				&& ((_flags & BGFX_SAMPLER_MAG_MASK) >> BGFX_SAMPLER_MAG_SHIFT) <= 2
+				&& ((_flags & BGFX_SAMPLER_COMPARE_MASK) >> BGFX_SAMPLER_COMPARE_SHIFT) <= 8;
+		}
+		static bool acceptsSwapChainFlags(uint32_t _flags)
+		{
+			const uint32_t known = BGFX_SWAP_CHAIN_MSAA_MASK | BGFX_SWAP_CHAIN_FULLSCREEN
+				| BGFX_SWAP_CHAIN_SRGB_BACKBUFFER | BGFX_SWAP_CHAIN_TRANSPARENT_BACKBUFFER
+				| BGFX_SWAP_CHAIN_HDR10 | BGFX_SWAP_CHAIN_HIDPI;
