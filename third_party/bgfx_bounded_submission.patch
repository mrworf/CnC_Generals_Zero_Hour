+				|| !bx::isFinite(_cmd.minDepth) || !bx::isFinite(_cmd.maxDepth)
+				|| _cmd.minDepth < 0.0f || _cmd.maxDepth > 1.0f || _cmd.minDepth > _cmd.maxDepth
+				|| !bx::isFinite(_cmd.clearDepth) || _cmd.clearDepth < 0.0f || _cmd.clearDepth > 1.0f
+				|| 0 != (_cmd.clearFlags & ~(BGFX_CLEAR_COLOR|BGFX_CLEAR_DEPTH|BGFX_CLEAR_STENCIL)))
+					return false;
+				if (0 == declared[_cmd.view])
+					++views;
+				declared[_cmd.view] = 1;
+				view[_cmd.view] = _cmd.framebuffer;
+				if (_cmd.touch)
+				{
+					rendered[_cmd.view] = 1;
+					++items;
+				}
+				return true;
+			}
+			case Cmd::Draw:
+			{
+				if (_cmd.view >= BGFX_CONFIG_MAX_VIEWS || !declared[_cmd.view]
+				|| !target(_ctx, view[_cmd.view]) || !live(program, _cmd.program.idx)
+				|| !live(vertex, _cmd.vertex.idx)
+				|| !isValid(_ctx.m_programRef[_cmd.program.idx].m_fsh)
+				|| !live(shader, _ctx.m_programRef[_cmd.program.idx].m_vsh.idx)
+				|| !live(shader, _ctx.m_programRef[_cmd.program.idx].m_fsh.idx)
+				|| 0 == _cmd.vertices
+				|| !BoundedSubmissionLimits::acceptsState(_cmd.state, _cmd.rgba)
+				|| !BoundedSubmissionLimits::acceptsStencil(_cmd.stencilFront)
+				|| !BoundedSubmissionLimits::acceptsStencil(_cmd.stencilBack)
+				|| _cmd.uniformCount > BGFX_CONFIG_MAX_UNIFORMS
+				|| _cmd.textureCount > g_caps.limits.maxTextureSamplers
+				|| (0 != _cmd.uniformCount && NULL == _cmd.uniforms)
+				|| (0 != _cmd.textureCount && NULL == _cmd.textures))
+					return false;
+				const VertexBuffer& vb = _ctx.m_vertexBuffers[_cmd.vertex.idx];
+				if (0 == vb.m_stride || uint64_t(_cmd.firstVertex) + _cmd.vertices > vb.m_size/vb.m_stride)
+					return false;
+				if (isValid(_cmd.index))
+				{
+					if (!live(index, _cmd.index.idx) || 0 == _cmd.indices)
+						return false;
+					const IndexBuffer& ib = _ctx.m_indexBuffers[_cmd.index.idx];
+					const uint32_t indexSize = 0 != (ib.m_flags & BGFX_BUFFER_INDEX32) ? 4 : 2;
+					if (uint64_t(_cmd.firstIndex) + _cmd.indices > ib.m_size/indexSize)
+						return false;
+				}
+				else if (0 != _cmd.indices || 0 != _cmd.firstIndex)
+					return false;
+				bx::memSet(uniformSeen, 0, sizeof(uniformSeen));
+				for (uint32_t ii = 0; ii < _cmd.uniformCount; ++ii)
+				{
+					const BoundedSubmissionUniform& value = _cmd.uniforms[ii];
+					if (!live(uniform, value.handle.idx) || uniformSeen[value.handle.idx])
+						return false;
+					const UniformRef& ref = _ctx.m_uniformRef[value.handle.idx];
+					if (UniformFreq::Draw != ref.m_freq || UniformType::Sampler == ref.m_type
+					|| ref.m_type >= UniformType::Count || UniformType::End == ref.m_type
+					|| 0 == value.count || value.count > ref.m_num
+					|| value.count > (kConstantOpcodeNumMask >> kConstantOpcodeNumShift)
+					|| value.bytes != uint64_t(g_uniformTypeSize[ref.m_type])*value.count || NULL == value.data)
+						return false;
+					uniformSeen[value.handle.idx] = 1;
+					uniformBytes += uint64_t(value.bytes) + sizeof(uint32_t);
+				}
+				uint32_t stages = 0;
+				for (uint32_t ii = 0; ii < _cmd.textureCount; ++ii)
+				{
+					const BoundedSubmissionTexture& value = _cmd.textures[ii];
+					if (value.stage >= g_caps.limits.maxTextureSamplers
+					|| !live(uniform, value.sampler.idx) || uniformSeen[value.sampler.idx]
+					|| !live(texture, value.texture.idx) || (stages & (1u << value.stage))
+					|| !BoundedSubmissionLimits::acceptsMipRange(value.firstMip, value.numMips,
+						_ctx.m_textureRef[value.texture.idx].m_numMips)
+					|| !BoundedSubmissionLimits::acceptsSamplerFlags(UINT32_MAX == value.flags
+						? uint32_t(_ctx.m_textureRef[value.texture.idx].m_flags) : value.flags)
+					|| _ctx.m_textureRef[value.texture.idx].isReadBack())
+						return false;
+					const UniformRef& ref = _ctx.m_uniformRef[value.sampler.idx];
+					if (UniformFreq::Draw != ref.m_freq || UniformType::Sampler != ref.m_type)
+						return false;
+					uniformSeen[value.sampler.idx] = 1;
+					stages |= 1u << value.stage;
+					uniformBytes += sizeof(uint32_t)*2;
+				}
+				rendered[_cmd.view] = 1;
+				++draws;
+				++items;
+				return true;
+			}
+			case Cmd::ResizeSwapChain:
+			{
+				++resources;
+				if (!live(framebuffer, _cmd.framebuffer.idx)
+				|| !_ctx.m_frameBufferRef[_cmd.framebuffer.idx].m_window)
+					return false;
+				const SwapChain& desc = _cmd.swapChain;
+				const SwapChain& accepted = swapchain[_cmd.framebuffer.idx];
+				if (desc.nwh != accepted.nwh || desc.ndt != accepted.ndt
+				|| desc.formatColor != accepted.formatColor || desc.formatDepthStencil != accepted.formatDepthStencil)
+					return false;
+				if (0 == desc.width || 0 == desc.height
+				|| desc.width > g_caps.limits.maxTextureSize || desc.height > g_caps.limits.maxTextureSize
+				|| desc.width > UINT16_MAX || desc.height > UINT16_MAX
+				|| !BoundedSubmissionLimits::acceptsSwapChainEncoding(desc)
+				|| (0 != (desc.flags & BGFX_SWAP_CHAIN_TRANSPARENT_BACKBUFFER) && 0 == (g_caps.supported & BGFX_CAPS_TRANSPARENT_BACKBUFFER))
+				|| (0 != (desc.flags & BGFX_SWAP_CHAIN_HDR10) && 0 == (g_caps.supported & BGFX_CAPS_HDR10)))
+					return false;
+				const uint32_t msaa = (desc.flags & BGFX_SWAP_CHAIN_MSAA_MASK) >> BGFX_SWAP_CHAIN_MSAA_SHIFT;
+				if (msaa > 4)
+					return false;
+				if (isValid(desc.depth))
+				{
+					if (!live(texture, desc.depth.idx))
+						return false;
+					const TextureRef& ref = _ctx.m_textureRef[desc.depth.idx];
+					const uint32_t samples = 0 == msaa ? 1 : 1u << msaa;
+					if (!ref.isRt() || !ref.isDepth() || BackbufferRatio::Count != ref.m_bbRatio
+					|| ref.m_width != desc.width || ref.m_height != desc.height || ref.m_numSamples != samples)
+						return false;
+				}
+				swapchain[_cmd.framebuffer.idx] = desc;
+				return true;
+			}
+			case Cmd::Retire:
+				++resources;
+				return retire(_ctx, _cmd);
+			case Cmd::CompleteFrame:
+				complete = true;
+				return _ordinal + 1 == _count;
+			default: return false;
+			}
+		}
+	};
+
+	bool submitBounded(const BoundedSubmissionDesc& _desc, const BoundedSubmissionCommand* _commands
+		, uint32_t _count, BoundedSubmissionReceipt& _receipt)
+	{
+#if !BGFX_CONFIG_MULTITHREADED
+		BX_UNUSED(_desc, _commands, _count, _receipt);
+		return false;
+#else
+		if (!BoundedSubmissionLimits::accepts(_desc, _count) || NULL == _commands || NULL == s_ctx
+		|| s_threadIndex != BGFX_API_THREAD_MAGIC || s_boundedPhase != BoundedSubmissionPhase::Idle)
+			return false;
+		Context& ctx = *s_ctx;
+		bx::MutexScope beginLock(ctx.m_encoderBeginLock);
+		bx::MutexScope encoderLock(ctx.m_encoderApiLock);
+		bx::MutexScope resourceLock(ctx.m_resourceApiLock);
+		if (ctx.m_singleThreaded || ctx.m_encoderHandle->getNumHandles() != 1
+		|| ctx.m_encoderHandle->getHandleAt(0) != 0
+		|| ctx.m_numFreeDynamicIndexBufferHandles != 0 || ctx.m_numFreeDynamicVertexBufferHandles != 0
+		|| (ctx.m_debug & BGFX_DEBUG_TEXT) || BX_ENABLED(BGFX_CONFIG_PROFILER) || NULL != ctx.m_init.callback
+		|| !ctx.m_uniformCache.m_uniformKeyHashMap.empty() || !ctx.m_uniformCache.m_uniformEntryMap.empty()
+		|| !ctx.m_encoder[0].m_uniformSet.empty()
+		|| ctx.m_boundedSequence == UINT64_MAX || (ctx.m_boundedContext == 0 && s_boundedContextSerial == UINT64_MAX))
+			return false;
+
+		// Waiting acquires the completed frame but emits/advances nothing. Every
+		// pre-replay return restores its exact completion token locally.
+		if (!ctx.m_renderSem.wait())
+			return false;
+		struct Owner
+		{
+			Context& ctx;
+			bool advanced = false;
+			explicit Owner(Context& _ctx) : ctx(_ctx)
+			{
+				s_boundedPhase = BoundedSubmissionPhase::Preparing;
+				s_boundedCompletion = true;
+			}
+			~Owner()
+			{
+				s_boundedUniforms = NULL;
+				s_boundedCompletion = false;
+				s_boundedPhase = BoundedSubmissionPhase::Idle;
+				if (!advanced)
+					ctx.m_renderSem.post();
+			}
+		} owner(ctx);
+		BoundedStorage storage(_desc.bytes);
+		// One checked immutable slab bounds all manifest copies; no per-draw
+		// allocator traffic is required even at the complete command limit.
+		uint64_t bytes = uint64_t(sizeof(BoundedSubmissionCommand))*_count;
+		const auto account = [&](uint64_t amount)
+		{
+			if (bytes > _desc.bytes || amount > _desc.bytes - bytes)
+				return false;
+			bytes = bx::alignUp(bytes + amount, UINT64_C(16));
+			return bytes <= _desc.bytes;
+		};
+		if (!account(0))
+			return false;
+		for (uint32_t ii = 0; ii < _count; ++ii)
+		{
+			const BoundedSubmissionCommand& cmd = _commands[ii];
+			if (cmd.kind >= BoundedSubmissionCommand::Count
+			|| (cmd.kind != BoundedSubmissionCommand::Draw && (cmd.uniformCount || cmd.textureCount))
+			|| cmd.uniformCount > BGFX_CONFIG_MAX_UNIFORMS || cmd.textureCount > g_caps.limits.maxTextureSamplers
+			|| (cmd.uniformCount && NULL == cmd.uniforms) || (cmd.textureCount && NULL == cmd.textures))
+				return false;
+			if (cmd.kind == BoundedSubmissionCommand::Draw)
+			{
+				if (!BoundedSubmissionLimits::acceptsState(cmd.state, cmd.rgba)
+				|| !BoundedSubmissionLimits::acceptsStencil(cmd.stencilFront)
+				|| !BoundedSubmissionLimits::acceptsStencil(cmd.stencilBack))
+					return false;
+				for (uint32_t jj = 0; jj < cmd.textureCount; ++jj)
+				{
+					const BoundedSubmissionTexture& value = cmd.textures[jj];
+					if (value.stage >= 32 || value.stage >= g_caps.limits.maxTextureSamplers
+					|| value.stage >= BGFX_CONFIG_MAX_TEXTURE_SAMPLERS || value.texture.idx >= BGFX_CONFIG_MAX_TEXTURES
+					|| !ctx.m_textureHandle.isValid(value.texture.idx)
+					|| !BoundedSubmissionLimits::acceptsMipRange(value.firstMip, value.numMips,
+						ctx.m_textureRef[value.texture.idx].m_numMips)
+					|| !BoundedSubmissionLimits::acceptsSamplerFlags(UINT32_MAX == value.flags
+						? uint32_t(ctx.m_textureRef[value.texture.idx].m_flags) : value.flags))
+						return false;
+				}
+			}
+			if (cmd.kind == BoundedSubmissionCommand::ResizeSwapChain
+			&& !BoundedSubmissionLimits::acceptsSwapChainEncoding(cmd.swapChain))
+				return false;
+			if (cmd.kind == BoundedSubmissionCommand::View
+			&& 0 != (cmd.clearFlags & ~(BGFX_CLEAR_COLOR|BGFX_CLEAR_DEPTH|BGFX_CLEAR_STENCIL)))
+				return false;
+			if (!account(uint64_t(sizeof(BoundedSubmissionUniform))*cmd.uniformCount))
+				return false;
+			for (uint32_t jj = 0; jj < cmd.uniformCount; ++jj)
+			{
+				if (NULL == cmd.uniforms[jj].data || 0 == cmd.uniforms[jj].bytes || !account(cmd.uniforms[jj].bytes))
+					return false;
+			}
+			if (!account(uint64_t(sizeof(BoundedSubmissionTexture))*cmd.textureCount))
+				return false;
+		}
+		auto* slab = (uint8_t*)storage.alloc(bytes);
+		if (NULL == slab)
+			return false;
+		auto* commands = reinterpret_cast<BoundedSubmissionCommand*>(slab);
+		uint64_t offset = bx::alignUp(uint64_t(sizeof(BoundedSubmissionCommand))*_count, UINT64_C(16));
+		for (uint32_t ii = 0; ii < _count; ++ii)
+		{
+			BX_PLACEMENT_NEW(&commands[ii], BoundedSubmissionCommand)(_commands[ii]);
+			BoundedSubmissionCommand& cmd = commands[ii];
+			auto* uniforms = reinterpret_cast<BoundedSubmissionUniform*>(slab + offset);
+			offset = bx::alignUp(offset + uint64_t(sizeof(BoundedSubmissionUniform))*cmd.uniformCount, UINT64_C(16));
+			for (uint32_t jj = 0; jj < cmd.uniformCount; ++jj)
+			{
+				BX_PLACEMENT_NEW(&uniforms[jj], BoundedSubmissionUniform)(cmd.uniforms[jj]);
+				bx::memCopy(slab + offset, uniforms[jj].data, uniforms[jj].bytes);
+				uniforms[jj].data = slab + offset;
+				offset = bx::alignUp(offset + uniforms[jj].bytes, UINT64_C(16));
+			}
+			cmd.uniforms = uniforms;
+			auto* textures = reinterpret_cast<BoundedSubmissionTexture*>(slab + offset);
+			for (uint32_t jj = 0; jj < cmd.textureCount; ++jj)
+				BX_PLACEMENT_NEW(&textures[jj], BoundedSubmissionTexture)(cmd.textures[jj]);
+			offset = bx::alignUp(offset + uint64_t(sizeof(BoundedSubmissionTexture))*cmd.textureCount, UINT64_C(16));
+			cmd.textures = textures;
+		}
+		BX_ASSERT(offset == bytes, "Immutable manifest extent mismatch.");
+		auto* model = (BoundedResourceModel*)storage.alloc(sizeof(BoundedResourceModel));
+		if (NULL == model)
+			return false;
+		// All members are value initialized before modeled release/validation.
+		BX_PLACEMENT_NEW(model, BoundedResourceModel)();
+		model->init(ctx);
+		for (uint32_t ii = 0; ii < _count; ++ii)
+			if (!model->validate(ctx, commands[ii], ii, _count))
+				return false;
+		Frame& frame = *ctx.m_submit;
+		if (model->draws > _desc.draws || model->views > _desc.views || model->resources > _desc.resources
+		|| uint64_t(frame.m_numRenderItems) + model->items > frame.m_maxDrawCalls
+		|| uint64_t(frame.m_numRenderBinds) + model->items + 1 > frame.m_maxDrawCalls
+		|| uint64_t(frame.m_frameCache.m_depthBiasCache.m_num) + model->draws > frame.m_frameCache.m_depthBiasCache.m_max)
+			return false;
+		if (!storage.arena(frame.m_renderItem, frame.m_numRenderItems + model->items + 1)
+		|| !storage.arena(frame.m_renderBind, frame.m_numRenderBinds + model->items + 1)
+		|| !storage.arena(frame.m_frameCache.m_depthBiasCache.m_cache, frame.m_frameCache.m_depthBiasCache.m_num + model->draws)
+		|| !storage.uniforms(frame.m_uniformBuffer[0], model->uniformBytes + 8))
+			return false;
+		// Conservative checked native-pool bound covers every recursive destroy
+		// and deferred vertex-layout command, including the ordinary prefix.
+		const uint64_t retirementBytes = uint64_t(BGFX_CONFIG_MAX_UNIFORMS + BGFX_CONFIG_MAX_SHADERS
+			+ BGFX_CONFIG_MAX_PROGRAMS + BGFX_CONFIG_MAX_TEXTURES + BGFX_CONFIG_MAX_FRAME_BUFFERS
+			+ BGFX_CONFIG_MAX_VERTEX_BUFFERS + BGFX_CONFIG_MAX_INDEX_BUFFERS + BGFX_CONFIG_MAX_VERTEX_LAYOUTS)*16;
+		const uint64_t resizeBytes = uint64_t(model->resources)*(sizeof(SwapChain) + 32);
+		if (!storage.commands(frame.m_cmdPre, resizeBytes)
+		|| !storage.commands(frame.m_cmdPost, retirementBytes + resizeBytes))
+			return false;
+		if (model->complete)
+		{
+			Frame& next = *ctx.m_render;
+			if (!storage.uniforms(next.m_uniformBuffer[0], 8)
+			|| !storage.commands(next.m_cmdPre, 8) || !storage.commands(next.m_cmdPost, 8))
+				return false;
+			if (BX_ENABLED(BGFX_CONFIG_DEBUG_TEXT))
+			{
+				const TextVideoMem& previous = *frame.m_textVideoMem;
+				const TextVideoMem& text = *next.m_textVideoMem;
+				// Active text is unsupported; unchanged bookkeeping capacity is
+				// a required, observable admission precondition, not a realloc.
+				const uint32_t width = bx::max(1u, ctx.m_init.swapChain.width/8);
+				const uint32_t height = bx::max(1u, ctx.m_init.swapChain.height/(previous.m_small ? 8u : 16u));
+				if (text.m_mem == NULL || text.m_width != width || text.m_height != height || text.m_small != previous.m_small)
+					return false;
+			}
+		}
+		s_boundedUniforms = model->uniformSeen;
+		const uint32_t before = frame.m_frameNum;
+		const uint32_t bindingsBefore = frame.m_numRenderBinds;
+		uint32_t bindingsAfter = bindingsBefore;
+		storage.publish();
+		s_boundedPhase = BoundedSubmissionPhase::Replaying;
+		for (uint32_t ii = 0; ii < _count; ++ii)
+		{
+			const BoundedSubmissionCommand& cmd = commands[ii];
+			using Cmd = BoundedSubmissionCommand;
+			switch (cmd.kind)
+			{
+			case Cmd::View:
+				setViewFrameBuffer(cmd.view, cmd.framebuffer);
+				setViewMode(cmd.view, ViewMode::Sequential);
+				setViewRect(cmd.view, cmd.x, cmd.y, cmd.width, cmd.height, cmd.minDepth, cmd.maxDepth);
+				setViewClear(cmd.view, cmd.clearFlags, cmd.clearRgba, cmd.clearDepth, cmd.clearStencil);
+				if (cmd.touch)
+					touch(cmd.view);
+				break;
+			case Cmd::Draw:
+				bx::memSet(s_boundedUniforms, 0, BGFX_CONFIG_MAX_UNIFORMS);
+				discard(BGFX_DISCARD_ALL);
+				setVertexBuffer(0, cmd.vertex, cmd.firstVertex, cmd.vertices);
+				if (isValid(cmd.index))
+					setIndexBuffer(cmd.index, cmd.firstIndex, cmd.indices);
+				for (uint32_t jj = 0; jj < cmd.uniformCount; ++jj)
+					setUniform(cmd.uniforms[jj].handle, cmd.uniforms[jj].data, cmd.uniforms[jj].count);
+				for (uint32_t jj = 0; jj < cmd.textureCount; ++jj)
+					setTexture(cmd.textures[jj].stage, cmd.textures[jj].sampler, cmd.textures[jj].texture,
+						0, UINT16_MAX, cmd.textures[jj].firstMip, cmd.textures[jj].numMips, cmd.textures[jj].flags);
+				setState(cmd.state, cmd.rgba);
+				setStencil(cmd.stencilFront, cmd.stencilBack);
+				setDepthControl(cmd.depthBias, 0.0f, 0.0f, false);
+				submit(cmd.view, cmd.program);
+				break;
+			case Cmd::ResizeSwapChain:
+				updateSwapChain(cmd.framebuffer, cmd.swapChain);
+				break;
+			case Cmd::Retire:
+				switch (cmd.resource)
+				{
+				case Cmd::Vertex: destroy(VertexBufferHandle{cmd.resourceIndex}); break;
+				case Cmd::Index: destroy(IndexBufferHandle{cmd.resourceIndex}); break;
+				case Cmd::Texture: destroy(TextureHandle{cmd.resourceIndex}); break;
+				case Cmd::Shader: destroy(ShaderHandle{cmd.resourceIndex}); break;
+				case Cmd::Program: destroy(ProgramHandle{cmd.resourceIndex}); break;
+				case Cmd::FrameBuffer: destroy(FrameBufferHandle{cmd.resourceIndex}); break;
+				default: BX_ASSERT(false, "Invalid admitted retirement."); break;
+				}
+				break;
+			case Cmd::CompleteFrame:
+				bindingsAfter = frame.m_numRenderBinds;
+				bgfx::frame();
+				owner.advanced = true;
+				break;
+			default: BX_ASSERT(false, "Invalid admitted command."); break;
+			}
+		}
+		if (!model->complete)
+			bindingsAfter = frame.m_numRenderBinds;
+		if (ctx.m_boundedContext == 0)
+			ctx.m_boundedContext = ++s_boundedContextSerial;
+		++ctx.m_boundedSequence;
+		BoundedSubmissionReceipt result;
+		result.context = ctx.m_boundedContext;
+		result.sequence = ctx.m_boundedSequence;
+		result.generation = _desc.generation;
+		result.frameBefore = before;
+		result.frameAfter = ctx.m_submit->m_frameNum;
+		result.draws = model->draws;
+		result.views = model->views;
+		result.bindingsBefore = bindingsBefore;
+		result.bindingsAfter = bindingsAfter;
+		_receipt = result;
+		return true;
+#endif
+	}
+
 #undef BGFX_CHECK_ENCODER0
 
 } // namespace bgfx
