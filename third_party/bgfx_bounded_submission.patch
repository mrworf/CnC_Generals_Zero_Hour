+	// Each checked allocation stays private until the complete reservation passes.
+	// Typed installers avoid type-punning Ty** through void**. Adopted payloads
+	// retain exactly the allocation/alignment expected by their original owner.
+	struct BoundedStorage
+	{
+		struct Node
+		{
+			Node* next;
+			void* data;
+			void* target;
+			void (*install)(Node&);
+			void (*cleanup)(void*);
+			uint32_t alignment;
+		};
+		Node* head = NULL;
+		uint64_t used = 0;
+		uint64_t limit;
+		explicit BoundedStorage(uint32_t _limit) : limit(_limit) {}
+		~BoundedStorage()
+		{
+			while (NULL != head)
+			{
+				Node* node = head;
+				head = node->next;
+				if (NULL != node->data)
+				{
+					if (NULL != node->cleanup)
+						node->cleanup(node->data);
+					else
+						bx::free(g_allocator, node->data, node->alignment);
+				}
+				bx::free(g_allocator, node);
+			}
+		}
+		void* alloc(uint64_t _bytes, uint32_t _alignment = 0)
+		{
+			if (0 == _bytes || _bytes > UINT32_MAX || used + sizeof(Node) + _bytes > limit)
+				return NULL;
+			Node* node = (Node*)bx::alloc(g_allocator, sizeof(Node));
+			if (NULL == node)
+				return NULL;
+			void* data = bx::alloc(g_allocator, size_t(_bytes), _alignment);
+			if (NULL == data)
+			{
+				bx::free(g_allocator, node);
+				return NULL;
+			}
+			*node = {head, data, NULL, NULL, NULL, _alignment};
+			head = node;
+			used += sizeof(Node) + _bytes;
+			bx::memSet(data, 0, size_t(_bytes));
+			return data;
+		}
+		template<typename Ty>
+		static void install(Node& _node)
+		{
+			Ty** target = static_cast<Ty**>(_node.target);
+			bx::free(g_allocator, *target, _node.alignment);
+			*target = static_cast<Ty*>(_node.data);
+			_node.data = NULL;
+		}
+		template<typename Ty>
+		bool replace(Ty*& _target, uint64_t _bytes, uint64_t _copy, uint32_t _alignment = 0)
+		{
+			void* data = alloc(_bytes, _alignment);
+			if (NULL == data)
+				return false;
+			if (NULL != _target && 0 != _copy)
+				bx::memCopy(data, _target, size_t(_copy));
+			head->target = &_target;
+			head->install = &install<Ty>;
+			return true;
+		}
+		template<typename Ty, uint32_t Block>
+		bool arena(FrameArenaT<Ty, Block>& _arena, uint32_t _count)
+		{
+#if BGFX_CONFIG_DYNAMIC_FRAME_STORAGE
+			const uint32_t count = FrameArenaT<Ty, Block>::numBlocks(_count);
+			if (count > _arena.m_numBlocks)
+				return false;
+			for (uint32_t ii = 0; ii < count; ++ii)
+				if (NULL == _arena.m_block[ii]
+				&& !replace(_arena.m_block[ii], uint64_t(sizeof(Ty))*Block, 0, BX_ALIGNOF(Ty)))
+					return false;
+#else
+			BX_UNUSED(_arena, _count);
+#endif
+			return true;
+		}
+		bool commands(CommandBuffer& _buffer, uint64_t _additional)
+		{
+			const uint64_t required = bx::alignUp(uint64_t(_buffer.m_pos) + _additional + 64, UINT64_C(1024));
+			if (required > UINT32_MAX)
+				return false;
+			if (required <= _buffer.m_capacity)
+				return true;
+			return replace(_buffer.m_buffer, required, _buffer.m_capacity);
+		}
+		bool uniforms(UniformBuffer*& _buffer, uint64_t _additional)
+		{
+			const uint64_t prefix = NULL == _buffer ? 0 : _buffer->m_pos;
+			const uint64_t required = bx::alignUp(prefix + _additional
+				+ BGFX_CONFIG_UNIFORM_BUFFER_RESIZE_THRESHOLD_SIZE + 16, UINT64_C(16));
+			if (required > UINT32_MAX)
+				return false;
+			if (NULL != _buffer && required <= _buffer->m_size)
+				return true;
+			const uint32_t header = sizeof(UniformBuffer)-sizeof(UniformBuffer::m_buffer);
+			void* data = alloc(required + header);
+			if (NULL == data)
+				return false;
+			UniformBuffer* next = BX_PLACEMENT_NEW(data, UniformBuffer)(uint32_t(required));
+			if (NULL != _buffer)
+			{
+				next->m_pos = _buffer->m_pos;
+				next->m_hwm = _buffer->m_hwm;
+				bx::memCopy(next->m_buffer, _buffer->m_buffer, size_t(prefix));
+			}
+			head->target = &_buffer;
+			head->install = &installUniform;
+			head->cleanup = &destroyUniformCandidate;
+			return true;
+		}
+		static void installUniform(Node& _node)
+		{
+			UniformBuffer** target = static_cast<UniformBuffer**>(_node.target);
+			if (NULL != *target)
+				UniformBuffer::destroy(*target);
+			*target = static_cast<UniformBuffer*>(_node.data);
+			_node.data = NULL;
+		}
+		static void destroyUniformCandidate(void* _data)
+		{
+			UniformBuffer::destroy(static_cast<UniformBuffer*>(_data));
+		}
+		void publish()
+		{
+			for (Node* node = head; NULL != node; node = node->next)
+				if (NULL != node->install)
+					node->install(*node);
+		}
+	};
