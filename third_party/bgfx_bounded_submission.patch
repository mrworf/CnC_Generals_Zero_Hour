+	bool boundedTrackUniform(uint16_t _handle)
+	{
+		if (!boundedReplayActive())
+			return false;
+		BX_ASSERT(_handle < BGFX_CONFIG_MAX_UNIFORMS && NULL != s_boundedUniforms, "Invalid admitted uniform tracking.");
